# systemd unit for ACCA TOOLS (Flask/gunicorn) on the VPS.
# Install:
#   sudo cp deploy/acca-tools.service /etc/systemd/system/acca-tools.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now acca-tools
# Manage:
#   systemctl status acca-tools
#   systemctl reload acca-tools     # graceful zero-downtime worker reload (HUP)
#   systemctl restart acca-tools    # full restart

[Unit]
Description=ACCA TOOLS (Flask/gunicorn)
After=network.target

[Service]
User=root
WorkingDirectory=/www/wwwroot/acca-tools
ExecStart=/www/wwwroot/acca-tools/.venv/bin/gunicorn -c gunicorn.conf.py app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
